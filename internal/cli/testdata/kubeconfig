# A minimal kubeconfig for the namespace-resolution tests. It carries no
# credentials of any kind: nothing here connects to anything, and the only field
# under test is the context's namespace.
apiVersion: v1
kind: Config
current-context: kuberecord-test
clusters:
  - name: kuberecord-test-cluster
    cluster:
      server: https://127.0.0.1:6443
contexts:
  - name: kuberecord-test
    context:
      cluster: kuberecord-test-cluster
      user: kuberecord-test-user
      namespace: from-the-kubeconfig
  - name: kuberecord-test-no-namespace
    context:
      cluster: kuberecord-test-cluster
      user: kuberecord-test-user
users:
  - name: kuberecord-test-user
    user: {}
